PORT=4000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-local-secret-key

# Worker auto-run settings used when the App submits a generation task.
WORKER_SCENE_PROVIDER=auto
WORKER_MAX_IMAGES=1

# Worker scene recognition through GLM.
GLM_API_KEY=replace-with-local-glm-key
AI_MODEL=glm-4-flash
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_PROVIDER=openai

# Worker image generation through GLM.
IMAGE_PROVIDER=glm
GLM_IMAGE_MODEL=glm-image
GLM_IMAGE_SIZE=1024x1024
