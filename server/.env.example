PORT=4000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-local-secret-key

# Optional override. The default is https://gutendex.com.
GUTENDEX_BASE_URL=https://gutendex.com

# Optional override. Only this trusted HTTPS MediaWiki API target is accepted.
WIKISOURCE_API_URL=https://zh.wikisource.org/w/api.php
# Optional for networks where Node cannot reach external book sources directly.
# HTTPS_PROXY=http://127.0.0.1:7897
# NO_PROXY=localhost,127.0.0.1

# Worker auto-run settings used when the App submits a generation task.
WORKER_AUTO_RUN=false
WORKER_MAX_IMAGES=1

# Worker scene recognition through Kimi K3.
KIMI_API_KEY=replace-with-local-kimi-key
AI_MODEL=kimi-k3
AI_BASE_URL=https://api.kimi.com/coding
AI_PROVIDER=anthropic

# Formal Server dispatch is hard-fenced to GLM image generation.
GLM_API_KEY=replace-with-local-glm-key
GLM_IMAGE_MODEL=glm-image

# Private demo only. Defaults to false; remove or set false before distribution.
# When false, all three VISION_AUDIT_* values are required before images can publish.
DEMO_SKIP_IMAGE_AUDIT=false
VISION_AUDIT_ENDPOINT=https://your-vision-endpoint.example/v1/audit
VISION_AUDIT_MODEL=vision-model
VISION_AUDIT_VERSION=audit-v1
