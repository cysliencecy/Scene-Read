KIMI_API_KEY=your-kimi-key
AI_MODEL=kimi-k3
AI_BASE_URL=https://api.kimi.com/coding
AI_PROVIDER=anthropic

# Optional real image generation provider.
# Set IMAGE_PROVIDER=glm in worker/.env for manual Worker runs.
# Set IMAGE_PROVIDER=glm in server/.env for server-triggered Worker runs.
IMAGE_PROVIDER=mock-svg
GLM_API_KEY=your-glm-or-bigmodel-key
GLM_IMAGE_MODEL=glm-image
GLM_IMAGE_SIZE=1536x1024

# Required for formal generation audit.
VISION_AUDIT_ENDPOINT=https://your-vision-endpoint.example/v1/audit
VISION_AUDIT_MODEL=vision-model
VISION_AUDIT_VERSION=audit-v1
